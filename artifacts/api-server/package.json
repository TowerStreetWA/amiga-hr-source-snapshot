{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:public-jobs": "node --experimental-strip-types --test tests/public-jobs.test.mjs",
    "test:public-applications": "node --experimental-strip-types --experimental-test-module-mocks --test tests/public-application.test.mjs",
    "test:public-uploads": "node --experimental-strip-types --test tests/public-upload-cleanup.test.mjs",
    "test:public-uploads:db": "node --experimental-strip-types --test tests/public-upload-cleanup.integration.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.23",
    "@clerk/shared": "^4.17.1",
    "@google-cloud/storage": "^7.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "google-auth-library": "^10.6.2",
    "http-proxy-middleware": "^4.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pino": "^9",
    "pino-http": "^10",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
